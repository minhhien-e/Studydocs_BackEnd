		},
		{
			"name": "Users (Business)",
			"description": "Cần Bearer token. Khuyến nghị: Login → GET /me để lấy userId.",
			"auth": {
				"type": "bearer",
				"bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
			},
			"item": [
				{
					"name": "Get Current User (me)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"if (json.data?.id) pm.collectionVariables.set('userId', json.data.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/users/me",
						"description": "Bearer token → Keycloak userinfo (sub) → Mongo findByKeycloakId → UserDTO."
					},
					"response": []
				},
				{
					"name": "Get All Users",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 && pm.response.json().data?.length) {",
									"  pm.collectionVariables.set('userId', pm.response.json().data[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/users"
					},
					"response": []
				},
				{
					"name": "Get User By Id",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/users/{{userId}}",
						"description": "userId = Mongo document id (lấy từ /me)."
					},
					"response": []
				},
				{
					"name": "Get Other User Info",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/users/{{userId}}/other",
						"description": "Public profile: avatar, fullName, school, social counts."
					},
					"response": []
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Updated Name\",\n  \"phoneNumber\": \"0901234567\",\n  \"avatarUrl\": \"https://example.com/avatar.png\",\n  \"gender\": \"male\",\n  \"dateOfBirth\": \"2000-01-15\",\n  \"address\": \"Ha Noi\",\n  \"school\": \"HUST\",\n  \"isPrivate\": false\n}"
						},
						"url": "{{baseUrl}}/api/v1/users/{{userId}}"
					},
					"response": []
				},
				{
					"name": "Update User Info",
					"request": {
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Updated Info\",\n  \"phoneNumber\": \"0909999888\",\n  \"gender\": \"female\",\n  \"dateOfBirth\": \"1999-05-20\",\n  \"address\": \"Ho Chi Minh\",\n  \"school\": \"UIT\",\n  \"isPrivate\": true\n}"
						},
						"url": "{{baseUrl}}/api/v1/users/{{userId}}/info"
					},
					"response": []
				},
				{
					"name": "Update User Image",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"avatarUrl\": \"https://example.com/new-avatar.png\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/users/{{userId}}/image"
					},
					"response": []
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"url": "{{baseUrl}}/api/v1/users/{{userId}}",
						"description": "Xóa Mongo profile (không xóa Keycloak user)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Keycloak (reference)",
			"description": "Gọi trực tiếp Keycloak — debug token / userinfo.",
			"item": [
				{
					"name": "OIDC Discovery",
					"request": {
						"method": "GET",
						"url": "{{keycloakUrl}}/realms/{{realm}}/.well-known/openid-configuration"
					},
					"response": []
				},
				{
					"name": "Token (password grant)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"  const j = pm.response.json();",
									"  pm.collectionVariables.set('accessToken', j.access_token);",
									"  pm.collectionVariables.set('refreshToken', j.refresh_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "password" },
								{ "key": "client_id", "value": "{{clientId}}" },
								{ "key": "client_secret", "value": "{{clientSecret}}" },
								{ "key": "username", "value": "{{username}}" },
								{ "key": "password", "value": "{{password}}" },
								{ "key": "scope", "value": "openid offline_access" }
							]
						},
						"url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
					},
					"response": []
				},
				{
					"name": "UserInfo (giải token → sub)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"  const j = pm.response.json();",
									"  if (j.sub) pm.collectionVariables.set('keycloakSub', j.sub);",
									"  console.log('sub (keycloakId):', j.sub);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
						},
						"method": "GET",
						"url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/userinfo",
						"description": "Cùng API backend dùng trong /me. sub = keycloakId trong Mongo."
					},
					"response": []
				}
			]
		}
	]
}
