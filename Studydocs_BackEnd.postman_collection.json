    {
      "name": "Media",
      "item": [
        {
          "name": "Init Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.mediaId) pm.collectionVariables.set('mediaId', String(json.mediaId));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentType\": \"application/pdf\",\n  \"fileName\": \"sample-document.pdf\",\n  \"sizeBytes\": 102400,\n  \"ownerType\": \"USER\",\n  \"ownerId\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/media/init-upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "media",
                "init-upload"
              ]
            }
          }
        },
        {
          "name": "Complete Upload",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
