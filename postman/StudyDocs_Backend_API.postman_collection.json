{
	"info": {
		"_postman_id": "studydocs-backend-full-fe-api-collection",
		"name": "StudyDocs Backend API Collection (FE Full Alignment)",
		"description": "Bộ Postman Collection kiểm thử 100% tất cả các endpoints mà Frontend gọi.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication API",
			"item": [
				{
					"name": "User Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@studydocs.com\",\n    \"password\": \"password123\",\n    \"fullName\": \"Test User FE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user/public/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"public",
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.accessToken) {",
									"    pm.environment.set('accessToken', jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@studydocs.com\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user/public/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"public",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Google OAuth Login URL",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/user/public/auth/google/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"public",
								"auth",
								"google",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
