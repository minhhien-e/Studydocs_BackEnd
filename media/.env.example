# Docker Compose injects these DB/Redis/JWT values for containers.
# Keep them here for local runs or manual overrides.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/studydocs_media_db
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ISSUER_URI=http://localhost:8180/realms/studydocs-app
CLOUDINARY_URL=cloudinary://dummy_api_key:dummy_api_secret@dummy_cloud_name
